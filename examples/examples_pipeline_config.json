{
    "configuracao_global": {
        "nome_sistema": "MIIDA Integration Engine Environment",
        "ambiente": "Desenvolvimento",
        "intervalo_limpeza_orfaos_minutos": 5
    },
    "configuracao_infraestrutura": {
        "origem_command": {
            "sgbd": "sqlserver",
            "host": "env:DB_ORIGEM_HOST",
            "porta": "1433",
            "usuario": "env:DB_ORIGEM_USER",
            "senha": "env:DB_ORIGEM_PASSWORD"
        },
        "destino_query": {
            "sgbd": "postgres",
            "host": "env:DB_DESTINO_HOST",
            "porta": "5432",
            "usuario": "env:DB_DESTINO_USER",
            "senha": "env:DB_DESTINO_PASSWORD"
        }
    },
    "bancos_gerenciados": [
        {
            "banco_legado": "erp_legado_db",
            "banco_moderno": "dw_moderno_db",
            "tabelas": [
                {
                    "tabela_legada": "tb_usuarios",
                    "tabela_moderna": "usuarios",
                    "schema_legado": "dbo",
                    "schema_moderno": "public",
                    "coluna_timestamp_controle": "dt_cadastro",
                    "intervalo_sincronizacao_segundos": 5,
                    "camada_anticorrupcao": {
                        "sanitizacao": {
                            "remover_espacos_excesso": true,
                            "forcar_utf8": true
                        },
                        "mapeamento_colunas": {
                            "cod_usuario": {
                                "nome_destino": "id",
                                "tipo": "INT",
                                "pk": true
                            },
                            "nome_completo": {
                                "nome_destino": "nome",
                                "tipo": "VARCHAR(150)"
                            },
                            "documento": {
                                "nome_destino": "documento_cpf",
                                "tipo": "VARCHAR(20)"
                            },
                            "flg_ativo": {
                                "nome_destino": "ativo",
                                "tipo": "BOOLEAN"
                            },
                            "dt_cadastro": {
                                "nome_destino": "criado_em",
                                "tipo": "TIMESTAMP"
                            }
                        }
                    }
                },
                {
                    "tabela_legada": "tb_vendas_itens",
                    "tabela_moderna": "vendas_itens",
                    "schema_legado": "dbo",
                    "schema_moderno": "public",
                    "coluna_timestamp_controle": "dt_alteracao",
                    "intervalo_sincronizacao_segundos": 10,
                    "camada_anticorrupcao": {
                        "sanitizacao": {
                            "remover_espacos_excesso": false,
                            "forcar_utf8": false
                        },
                        "mapeamento_colunas": {
                            "num_venda": {
                                "nome_destino": "venda_id",
                                "tipo": "INT",
                                "pk": true
                            },
                            "seq_item": {
                                "nome_destino": "sequencial",
                                "tipo": "INT",
                                "pk": true
                            },
                            "cod_produto": {
                                "nome_destino": "produto_id",
                                "tipo": "INT"
                            },
                            "qtd_vendida": {
                                "nome_destino": "quantidade",
                                "tipo": "DECIMAL(10,2)"
                            },
                            "vlr_unitario": {
                                "nome_destino": "preco_unitario",
                                "tipo": "DECIMAL(10,2)"
                            },
                            "dt_alteracao": {
                                "nome_destino": "atualizado_em",
                                "tipo": "TIMESTAMP"
                            }
                        }
                    }
                }
            ]
        }
    ]
}